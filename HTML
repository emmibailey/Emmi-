<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Catch the Droplets Game</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      background: #e0f7fa;
      font-family: 'Segoe UI', Arial, sans-serif;
      touch-action: none;
      user-select: none;
    }
    #gameCanvas {
      display: block;
      margin: 0 auto;
      background: #b3e5fc;
      border: 2px solid #0288d1;
      border-radius: 10px;
      max-width: 100vw;
      max-height: 80vh;
      touch-action: none;
    }
    #info {
      text-align: center;
      margin-bottom: 10px;
      color: #0288d1;
      font-size: 1.2em;
    }
    .btn-group {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-top: 10px;
    }
    .mobile-btn {
      width: 50px;
      height: 50px;
      font-size: 2em;
      background: #fff;
      border: 2px solid #039be5;
      border-radius: 8px;
      color: #039be5;
      box-shadow: 1px 1px 4px #bbb;
      touch-action: manipulation;
      margin-bottom: 10px;
    }
    .mobile-btn:active {
      background: #b3e5fc;
    }
  </style>
</head>
<body>
  <div id="info">
    Catch the <b>blue</b> droplets! <span style="color:grey;">Avoid grey ones!</span>
    <br>
    <span id="score">Score: 0</span>
  </div>
  <canvas id="gameCanvas" width="400" height="600"></canvas>
  <div class="btn-group" id="mobileControls" style="display:none;">
    <button class="mobile-btn" id="leftBtn">&#8592;</button>
    <button class="mobile-btn" id="rightBtn">&#8594;</button>
  </div>
  <script>
    // Responsive sizing
    function resizeCanvas() {
      var c = document.getElementById('gameCanvas');
      var scale = Math.min(window.innerWidth / 400, window.innerHeight / 650, 1);
      c.style.width = (400 * scale) + "px";
      c.style.height = (600 * scale) + "px";
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // Game Variables
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    let isMobile = /Android|iPhone|iPad|iPod|Opera Mini|IEMobile|WPDesktop/i.test(navigator.userAgent);

    // Show mobile controls if on mobile
    if(isMobile) {
      document.getElementById('mobileControls').style.display = "flex";
    }

    // Catcher (basket/bar)
    const catcher = {
      x: 180,
      width: 60,
      height: 20,
      y: 570,
      speed: 7,
      move: 0 // -1 = left, 1 = right
    };

    // Droplets
    let droplets = [];
    let dropInterval = 900; // ms between droplet spawns (decreases over time)
    let lastDrop = 0;
    let dropletFallSpeed = 3;

    // Score
    let score = 0;
    let gameOver = false;

    // Utility: colors
    const dropletColors = [
      { color: "#0288d1", good: true }, // blue
      { color: "#81d4fa", good: true }, // light blue
      { color: "#757575", good: false } // grey
    ];

    // Input Handling (desktop)
    document.addEventListener('keydown', e => {
      if(e.key === "ArrowLeft") catcher.move = -1;
      else if(e.key === "ArrowRight") catcher.move = 1;
    });
    document.addEventListener('keyup', e => {
      if ((e.key === "ArrowLeft" && catcher.move === -1) ||
          (e.key === "ArrowRight" && catcher.move === 1)) {
        catcher.move = 0;
      }
    });

    // Input Handling (mobile buttons)
    let leftInterval, rightInterval;
    function mobileMove(direction) {
      clearInterval(leftInterval);
      clearInterval(rightInterval);
      if(direction === -1) {
        leftInterval = setInterval(() => {catcher.move = -1;}, 20);
      } else if(direction === 1) {
        rightInterval = setInterval(() => {catcher.move = 1;}, 20);
      }
    }
    function stopMove() {
      catcher.move = 0;
      clearInterval(leftInterval);
      clearInterval(rightInterval);
    }

    if(isMobile) {
      document.getElementById('leftBtn').addEventListener('touchstart', () => mobileMove(-1));
      document.getElementById('rightBtn').addEventListener('touchstart', () => mobileMove(1));
      document.getElementById('leftBtn').addEventListener('touchend', stopMove);
      document.getElementById('rightBtn').addEventListener('touchend', stopMove);
    }

    // Touch controls (drag anywhere to move catcher)
    let touchStartX = null;
    canvas.addEventListener('touchstart', e => {
      if(e.touches.length === 1) {
        touchStartX = e.touches[0].clientX;
      }
    });
    canvas.addEventListener('touchmove', e => {
      if(e.touches.length === 1 && touchStartX !== null) {
        let dx = e.touches[0].clientX - touchStartX;
        catcher.x += dx;
        catcher.x = Math.max(0, Math.min(canvas.width - catcher.width, catcher.x));
        touchStartX = e.touches[0].clientX;
      }
    });
    canvas.addEventListener('touchend', e => {
      touchStartX = null;
    });

    // Droplet spawner
    function spawnDroplet() {
      let t = Math.random();
      // 70% blue/light blue (good), 30% grey (bad)
      let dropType = t < 0.7 ? (Math.random()<0.5?0:1) : 2;
      let colorObj = dropletColors[dropType];
      let x = Math.random() * (canvas.width - 30);
      droplets.push({
        x: x,
        y: -30,
        radius: 18,
        ...colorObj
      });
    }

    // Collision detection
    function caught(d) {
      return (
        d.y + d.radius >= catcher.y &&
        d.y + d.radius <= catcher.y + catcher.height &&
        d.x + d.radius > catcher.x &&
        d.x < catcher.x + catcher.width
      );
    }

    // Main Game Loop
    function loop(ts) {
      if(gameOver) return;
      ctx.clearRect(0,0,canvas.width,canvas.height);

      // Move catcher
      catcher.x += catcher.move * catcher.speed;
      catcher.x = Math.max(0, Math.min(canvas.width - catcher.width, catcher.x));

      // Draw catcher
      ctx.fillStyle = "#01579b";
      ctx.fillRect(catcher.x, catcher.y, catcher.width, catcher.height);
      ctx.fillStyle = "#fff";
      ctx.font = "14px Arial";
      ctx.textAlign = "center";
      ctx.fillText("You", catcher.x+catcher.width/2, catcher.y+16);

      // Spawn new droplets
      if(!lastDrop || ts - lastDrop > dropInterval) {
        spawnDroplet();
        lastDrop = ts;
        if(dropInterval > 500) dropInterval *= 0.985; // Speed up spawn rate
        if(dropletFallSpeed < 8) dropletFallSpeed += 0.005;
      }

      // Move & draw droplets
      for(let i = droplets.length-1; i >= 0; i--) {
        let d = droplets[i];
        d.y += dropletFallSpeed;

        ctx.beginPath();
        ctx.arc(d.x + d.radius, d.y + d.radius, d.radius, 0, Math.PI*2);
        ctx.fillStyle = d.color;
        ctx.shadowColor = d.good ? "#fff" : "#888";
        ctx.shadowBlur = d.good ? 8 : 2;
        ctx.fill();
        ctx.shadowBlur = 0;

        // Was it caught?
        if(caught(d)) {
          if(d.good) {
            score += 1;
          } else {
            // End game if grey droplet is caught
            gameOver = true;
            document.getElementById('score').innerHTML = `Game Over! Final Score: ${score}`;
            setTimeout(() => {
              if(confirm("Game Over! You caught a grey droplet!\nYour score: "+score+"\nPlay again?")){
                window.location.reload();
              }
            }, 200);
          }
          droplets.splice(i,1);
          continue;
        }
        // Remove if out of bounds
        if(d.y > canvas.height+40) {
          droplets.splice(i,1);
        }
      }

      // Update score
      document.getElementById('score').innerHTML = `Score: ${score}`;

      if(!gameOver) requestAnimationFrame(loop);
    }

    loop();
  </script>
</body>
</html>
